# Copy to .env and fill in. Never commit .env.
OPENROUTER_API_KEY=sk-or-...
RCP_MODEL=deepseek/deepseek-v4-flash
RCP_BASE_URL=https://openrouter.ai/api/v1
# RCP_REASONING=false            # enable provider reasoning mode
# RCP_OM_IMAGE=rcp-openmodelica-buildings:13.0.0-om1.26.3
# RCP_OM_BACKEND=auto            # auto | docker | local | ompython
# RCP_LIBRARY_PATH=              # local/ompython only; defaults to vendor/
# RCP_MAILTO=you@example.com     # OpenAlex polite-pool email
# RCP_MAX_BATCH_CASES=18

# HTTP Basic auth. Required before exposing the API to anything but loopback --
# `rcp serve` refuses to start without it. Generate: openssl rand -base64 24
# Then: chmod 600 .env      (see docs/DEPLOYMENT.md)
# RCP_AUTH_USER=rcp
# RCP_AUTH_PASSWORD=

# Open-access PDF acquisition (see docs/DEPLOYMENT.md and src/rcp/literature/)
# RCP_FETCH_OA_PDFS=true         # fetch licence-checked open-access full text
# RCP_PDF_ALLOW_BRONZE=false     # bronze OA is free to read but states no licence
# RCP_UNPAYWALL_ENABLED=true     # needs RCP_MAILTO to be set
# RCP_PDF_MAX_BYTES=40000000
# RCP_PDF_MAX_PAGES=80

# Evaluation rubric (docs/EVALUATION.md)
# RCP_MIN_RUBRIC_REVIEWERS=2     # peer scores stay concealed until this many submit
# RCP_REQUIRE_RUBRIC_REVIEWS=0   # 0 keeps acceptance unblocked
