{
  "DataCenterRoom": {
    "file": "DataCenterRoom.mo",
    "class_name": "DataCenterRoom",
    "description": "Lumped thermal model of a data center room: IT heat load, envelope losses, proportional cooling with COP-based electric power. Fast, self-contained (no MSL dependencies).",
    "validation_status": "conceptual",
    "model_version": "1.0.0-conceptual",
    "validation_report_id": "DataCenterRoom-1.0.0-conceptual",
    "limitations": [
      "Conceptual, single-zone lumped model; it is not calibrated against a physical facility.",
      "No spatial hot spots, humidity, airflow network, equipment transients, or sensor uncertainty.",
      "Cooling uses a proportional controller and constant COP rather than a detailed plant model.",
      "Successful execution is exploratory evidence and must not be described as publication-strength validation."
    ],
    "operating_range": {
      "Q_it": {
        "min": 10000,
        "max": 120000,
        "unit": "W"
      },
      "T_amb": {
        "min": 10,
        "max": 40,
        "unit": "degC"
      },
      "T_set": {
        "min": 18,
        "max": 30,
        "unit": "degC"
      },
      "T": {
        "min": 15,
        "max": 45,
        "unit": "degC"
      }
    },
    "default_stop_time": 86400,
    "outputs": [
      "T",
      "Q_cool",
      "P_cool",
      "E_cool"
    ],
    "parameters": {
      "Q_it": {
        "default": 50000,
        "min": 1000,
        "max": 500000,
        "unit": "W",
        "description": "IT heat load"
      },
      "C_room": {
        "default": 2000000,
        "min": 100000,
        "max": 100000000,
        "unit": "J/K",
        "description": "Room thermal capacitance"
      },
      "UA": {
        "default": 2000,
        "min": 0,
        "max": 50000,
        "unit": "W/K",
        "description": "Envelope conductance to ambient"
      },
      "T_amb": {
        "default": 30,
        "min": -20,
        "max": 55,
        "unit": "degC",
        "description": "Ambient temperature"
      },
      "T_set": {
        "default": 24,
        "min": 15,
        "max": 35,
        "unit": "degC",
        "description": "Cooling setpoint"
      },
      "Q_cool_max": {
        "default": 80000,
        "min": 1000,
        "max": 1000000,
        "unit": "W",
        "description": "Maximum cooling capacity"
      },
      "k_p": {
        "default": 20000,
        "min": 100,
        "max": 1000000,
        "unit": "W/K",
        "description": "Proportional controller gain"
      },
      "COP": {
        "default": 3.5,
        "min": 1.0,
        "max": 10.0,
        "unit": "-",
        "description": "Cooling coefficient of performance"
      }
    }
  },
