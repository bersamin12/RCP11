+# --- OpenRouter integration (notebook patch) --------------------------------
+# Two things the stock client cannot express, both needed to drive OpenEvolve
+# through OpenRouter from a notebook:
+#   * OPENEVOLVE_OPENROUTER=1 sends OpenRouter's ``reasoning``/``usage`` fields
+#     as extra_body.  Hidden reasoning tokens are billed against max_tokens, so
+#     without disabling them a long code generation is truncated before the
+#     first SEARCH/REPLACE block appears.
+#   * OPENEVOLVE_USAGE_LOG=<path> appends one JSON line of token/cost usage per
+#     API call.  Evolution runs in worker *processes*, so an in-process counter
+#     in the notebook would never see them.
+def _openrouter_extra_body() -> Optional[Dict[str, Any]]:
+    if os.environ.get("OPENEVOLVE_OPENROUTER", "0") != "1":
+        return None
+    return {"reasoning": {"enabled": False}, "usage": {"include": True}}
+
+
+def _log_usage(model: str, response: Any) -> None:
+    path = os.environ.get("OPENEVOLVE_USAGE_LOG")
+    if not path:
+        return
+    usage = getattr(response, "usage", None)
+    record = {
+        "model": model,
+        "prompt_tokens": int(getattr(usage, "prompt_tokens", 0) or 0),
+        "completion_tokens": int(getattr(usage, "completion_tokens", 0) or 0),
+        "cost": float(getattr(usage, "cost", 0.0) or 0.0),
+    }
+    try:
+        with open(path, "a", encoding="utf-8") as fh:
+            fh.write(json.dumps(record) + "\n")
+    except OSError:  # never let bookkeeping break evolution
+        pass
+
+
 def _iso_now() -> str:
     return datetime.now(tz=timezone.utc).isoformat()
 
