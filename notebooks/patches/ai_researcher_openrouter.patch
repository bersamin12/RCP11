+# --- RCP notebook patch ------------------------------------------------------------------
+# The repo builds a separate OpenAI / Anthropic / Together client per model family. For the
+# notebook every role must go through ONE OpenAI-compatible endpoint (RCP_BASE_URL) with one
+# model (RCP_MODEL), so call_api() short-circuits to call_api_rcp() whenever RCP_BASE_URL is
+# set. Nothing else in the repo changes: the (client, model) arguments are simply ignored.
+_RCP_CLIENT = None
+
+
+def rcp_client():
+    """Singleton OpenAI-SDK client pointed at RCP_BASE_URL (OpenAI-compatible, e.g. OpenRouter)."""
+    global _RCP_CLIENT
+    if _RCP_CLIENT is None:
+        from openai import OpenAI
+
+        _RCP_CLIENT = OpenAI(
+            api_key=os.environ.get("OPENROUTER_API_KEY", ""),
+            base_url=os.environ.get("RCP_BASE_URL", "https://openrouter.ai/api/v1"),
+            timeout=600,
+            max_retries=2,
+        )
+    return _RCP_CLIENT
+
+
+RCP_USAGE_HOOK = None   # notebook sets this to a callable(usage, seconds, tag) -> None
+RCP_TAG = "ai_researcher"
+
+
+def call_api_rcp(prompt_messages, temperature=1.0, top_p=1.0, max_tokens=1000, seed=2024, json_output=False):
+    """One chat completion through RCP_MODEL; returns (text, cost) like the original call_api.
+
+    Hidden reasoning is disabled: on reasoning models the reasoning tokens count against
+    max_tokens, which truncates long JSON proposals before the closing brace.
+    """
+    import time
+
+    kwargs = dict(
+        model=os.environ.get("RCP_MODEL", "deepseek/deepseek-v4-flash"),
+        messages=prompt_messages,
+        temperature=temperature,
+        top_p=top_p,
+        max_tokens=max_tokens,
+        seed=seed,
+        extra_body={"reasoning": {"enabled": False}},
+    )
+    if json_output:
+        kwargs["response_format"] = {"type": "json_object"}
+    t0 = time.time()
+    completion = rcp_client().chat.completions.create(**kwargs)
+    usage = getattr(completion, "usage", None)
+    if RCP_USAGE_HOOK is not None:
+        RCP_USAGE_HOOK(usage, time.time() - t0, RCP_TAG)
+    cost = float(getattr(usage, "cost", 0.0) or 0.0)
+    text = (completion.choices[0].message.content or "").strip()
+    if completion.choices[0].finish_reason == "length":
+        print("[warning] response hit max_tokens and was truncated")
+    return text, cost
+
+
