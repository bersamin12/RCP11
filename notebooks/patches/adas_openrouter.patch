+# --- RCP: talk to any OpenAI-compatible endpoint (OpenRouter) instead of api.openai.com,
+# and route every hard-coded gpt-3.5/gpt-4 model id to the project model (RCP_MODEL).
+RCP_BASE_URL = os.environ.get("RCP_BASE_URL", "https://openrouter.ai/api/v1")
+RCP_MODEL = os.environ.get("RCP_MODEL", "gpt-3.5-turbo-0125")
+RCP_REASONING = os.environ.get("NB_REASONING", "off")
+# The repo's own value; overridable because OpenRouter reserves credit for the *whole* completion
+# budget of every in-flight request and refuses the call with HTTP 402 when the balance is low.
+RCP_MAX_TOKENS = int(os.environ.get("NB_MAX_TOKENS", "4096"))
+
+client = openai.OpenAI(
+    api_key=os.environ.get("OPENROUTER_API_KEY") or os.environ.get("OPENAI_API_KEY"),
+    base_url=RCP_BASE_URL,
+    timeout=300,
+    max_retries=2,
+)
+
+# Set by the notebook to record tokens/cost of every call made by the meta agent and by the
+# agents inside forward(); left as None the repo behaves exactly as published.
+USAGE_HOOK = None
+
+
+def _resolve_model(model):
+    """Every model name used by this repo is an OpenAI id; send them all to RCP_MODEL."""
+    return RCP_MODEL
+
+
+def _extra_body():
+    # Hidden reasoning tokens count against max_tokens on reasoning models, which truncates the
+    # meta agent's code before it is emitted; "off" disables them.
+    return {"reasoning": {"enabled": False}} if RCP_REASONING == "off" else {"reasoning": {"effort": RCP_REASONING}}
+
+
+def _retryable(exc):
+    """Retry the transient statuses; 402 here means "in-flight credit budget", not "no credits"."""
+    return getattr(exc, "status_code", None) not in (402, 408, 409, 429, 500, 502, 503, 504)
+
+
+def _track(response, tag, seconds):
+    if USAGE_HOOK is not None:
+        USAGE_HOOK(response, tag, seconds)
+
 
